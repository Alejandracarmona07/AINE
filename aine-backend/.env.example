# Copia este archivo como .env para desarrollo local con XAMPP
# cp .env.example .env

PORT=3001

# XAMPP (MySQL/MariaDB local)
MYSQL_ADDON_HOST=127.0.0.1
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_USER=root
MYSQL_ADDON_PASSWORD=
MYSQL_ADDON_DB=aine_db

# Opcional: URI completa (tiene prioridad si está definida)
# MYSQL_ADDON_URI=mysql://root@127.0.0.1:3306/aine_db
