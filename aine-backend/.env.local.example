# Copia este archivo como .env.local para desarrollo con XAMPP:
# cp .env.local.example .env.local
#
# .env.local tiene prioridad sobre .env (útil si .env tiene credenciales de producción)

PORT=3001

MYSQL_ADDON_HOST=127.0.0.1
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_USER=root
MYSQL_ADDON_PASSWORD=
MYSQL_ADDON_DB=aine_db

# Vacío para no usar la URI de producción del .env
MYSQL_ADDON_URI=

# Opcional: URI completa local (tiene prioridad sobre host/user/db)
# MYSQL_ADDON_URI=mysql://root@127.0.0.1:3306/aine_db
