# Copia como .env.local para desarrollo:
# cp .env.local.example .env.local

PORT=3001

# Opción A — Clever Cloud (por defecto si no defines MYSQL_* aquí):
# Usa las credenciales de .env (MYSQL_ADDON_URI de Clever Cloud)

# Opción B — XAMPP local (descomenta y enciende MySQL en XAMPP):
# MYSQL_ADDON_HOST=127.0.0.1
# MYSQL_ADDON_PORT=3306
# MYSQL_ADDON_USER=root
# MYSQL_ADDON_PASSWORD=
# MYSQL_ADDON_DB=aine_db
# MYSQL_ADDON_URI=
