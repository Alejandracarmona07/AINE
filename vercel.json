{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd aine-frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd aine-frontend && npm run build",
  "outputDirectory": "aine-frontend/dist",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
