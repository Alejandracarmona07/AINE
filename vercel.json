{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix aine-frontend --no-audit --no-fund",
  "buildCommand": "npm run build --prefix aine-frontend",
  "outputDirectory": "aine-frontend/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
